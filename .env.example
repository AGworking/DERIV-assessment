# Support Copilot Pipeline — environment configuration template.
#
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — secrets never get committed.
#
# All variables are OPTIONAL. With none set, the pipeline runs in mock mode
# (no network calls, no keys required) and produces the same deterministic
# artifacts every run.

# ---------------------------------------------------------------------------
# LLM provider feature flag
# ---------------------------------------------------------------------------
# Values:
#   mock   (default) — uses src/llm/provider.py:MockProvider, no network calls
#   openai           — uses real OpenAI calls; requires OPENAI_API_KEY below
LLM_PROVIDER=mock

# ---------------------------------------------------------------------------
# OpenAI credentials (only required when LLM_PROVIDER=openai)
# ---------------------------------------------------------------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: override the model. Defaults to gpt-4o-mini if omitted.
# Other reasonable choices: gpt-4o, gpt-4-turbo
OPENAI_MODEL=gpt-4o-mini
